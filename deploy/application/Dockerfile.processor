# syntax=docker/dockerfile:1.6
# Processor image: Python dependencies and code only — embedding models are mounted at runtime.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/app \
    PROCESSOR_PORT=8082 \
    MODELS_ROOT=/app/src/models \
    HF_HOME=/app/src/models \
    TRANSFORMERS_CACHE=/app/src/models \
    SENTENCE_TRANSFORMERS_HOME=/app/src/models

WORKDIR /app

# Copy only application code (skip .env / .venv — OneDrive reparse points break BuildKit on Windows).
COPY src ./src

RUN --mount=type=cache,target=/root/.cache/pip \
    apt-get update \
    && apt-get install -y --no-install-recommends libreoffice-writer-nogui libreoffice-impress-nogui ffmpeg tesseract-ocr \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip install --upgrade pip setuptools wheel \
    && python -m pip install --extra-index-url https://download.pytorch.org/whl/cpu "torch>=2.0.0" \
    && python -m pip install "./src/workers/document_processor"

RUN mkdir -p /app/documents /app/src/models

CMD ["sh", "-c", "uvicorn src.workers.document_processor.api_server:app --host 0.0.0.0 --port ${PROCESSOR_PORT}"]
