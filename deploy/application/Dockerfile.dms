# syntax=docker/dockerfile:1.6
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/app \
    DEPLOYMENT_MODE=docker \
    RUNNING_IN_DOCKER=1

WORKDIR /app

COPY src ./src
RUN --mount=type=cache,target=/root/.cache/pip \
    apt-get update \
    && apt-get install -y --no-install-recommends libreoffice-writer-nogui libreoffice-impress-nogui tesseract-ocr \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip install --upgrade pip setuptools wheel \
    && python -m pip install --index-url https://download.pytorch.org/whl/cpu "torch>=2.0.0" \
    && python -m pip install "./src/application[retrieval,preview,neo4j]"

RUN mkdir -p /app/documents /app/src/models

EXPOSE 8088

CMD ["python", "-m", "src.application.consumer_api.main"]
