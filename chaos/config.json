{
  "environment": "test",
  "scheduler": {
    "tcp_host": "localhost",
    "tcp_port": 3200,
    "container_name": "rag-scheduler-service"
  },
  "rabbitmq": {
    "host": "localhost",
    "port": 5672,
    "queue_name": "document_processing_queue",
    "container_name": "rag-builder-dependencies-rabbitmq-1"
  },
  "database": {
    "container_name": "rag-postgres"
  },
  "workers": {
    "target_containers": [
      "doc_processor_1",
      "doc_processor_2",
      "doc_processor_3",
      "doc_processor_4",
      "doc_processor_5"
    ],
    "default_target": "doc_processor_1",
    "base_port": 3100
  },
  "resilience": {
    "max_retries": 3,
    "heartbeat_timeout_seconds": 30,
    "reconciliation_wait_seconds": 15,
    "job_timeout_seconds": 1800
  }
}
